{
  "manifest_version": 3,
  "name": "抖音搜索增强 DouyinSearchPlus",
  "version": "1.0.0",
  "description": "抖音网页版选题助手（非官方）：按收藏率挑选题、候选篮一键生成入库包、评论区按赞或回复排序。免登录，数据只在本机。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "抖音搜索增强",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["src/page/bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.douyin.com/*"],
      "js": [
        "src/content/util.js",
        "src/content/metrics.js",
        "src/content/store.js",
        "src/content/export.js",
        "src/content/adapters.js",
        "src/content/loader.js",
        "src/content/presenter.js",
        "src/content/comments.js",
        "src/content/inplace.js",
        "src/content/ui-css.js",
        "src/content/ui-kit.js",
        "src/content/ui-cards.js",
        "src/content/ui-toolbar.js",
        "src/content/ui-basket.js",
        "src/content/ui-comments.js",
        "src/content/ui.js",
        "src/content/app.js"
      ],
      "css": ["src/content/page.css"],
      "run_at": "document_start"
    }
  ]
}
